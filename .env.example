# Copy to .env in the repository root for local frontend development.
# Vite proxies these same-origin paths to the locally running APIs.
VITE_PORT=5173
VITE_API_JAVA_BASE=/api/java
VITE_API_PYTHON_BASE=/api/python
DEV_JAVA_API_URL=http://localhost:8080
DEV_PYTHON_API_URL=http://localhost:8000

# Optional Docker Compose only. Direct local development does not use these
# values; see backend/java/.env.example and backend/python/.env.example.
MYSQL_DATABASE=agroclima
MYSQL_USER=agroclima
MYSQL_PASSWORD=change-this-to-a-unique-long-database-password
MYSQL_ROOT_PASSWORD=change-this-to-a-different-root-password
MYSQL_PORT=3306
JWT_SECRET=replace-with-at-least-32-random-bytes-for-jwt-signing
INTERNAL_API_KEY=replace-with-another-at-least-32-random-bytes
INITIAL_ADMIN_EMAIL=admin@agroclima.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_TTL_MINUTES=60
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Optional ThingSpeak source, used by the Python service when CHANNEL_ID is set.
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
THINGSPEAK_URL=https://api.thingspeak.com
THINGSPEAK_FIELD_MAP={"temperature":"field1","humidity":"field2","rainfall":"field3","luminosity":"field4","soilHumidity":"field5"}
THINGSPEAK_POLL_INTERVAL_SECONDS=300
THINGSPEAK_RESULTS_LIMIT=500

# Explicit local browser origins. No wildcard is used.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8081,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8081
JAVA_PORT=8080
PYTHON_PORT=8000
FRONTEND_PORT=8081
